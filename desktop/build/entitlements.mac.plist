<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The app (Electron's main process) under the hardened runtime: V8 needs JIT pages. Nothing else: no unsigned executable
       memory, and library validation stays on (every framework in the bundle carries this app's signature). Each program
       gets only what it needs: entitlements.mac.inherit.plist for Electron's helpers, entitlements.sidecar.plist for the
       register program, none for cloudflared (scripts/sign-bundled-programs.cjs; desktop/README.md, Build and sign). -->
  <key>com.apple.security.cs.allow-jit</key><true/>
</dict>
</plist>
